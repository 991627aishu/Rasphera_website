rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /contacts/{document=**} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }
    
    match /event_bookings/{document=**} {
      allow create: if request.auth != null;
      allow read, write: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.uid != null); // Simplification: admin read covered below if needed.
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
